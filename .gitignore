# ==========================================
# 🛑 INFRASTRUCTURE & DATA (CRITICAL)
# ==========================================
# NEVER commit local databases, attachments, or vector memory.
# This ensures Office and Home environments remain completely isolated.
infrastructure/volumes/

# Ignore environment variables (if you add an .env later for secrets)
*.env
.env
.env.*

# ==========================================
# 🛠️ COMPILED TOOLING & BINARIES
# ==========================================
# Ignore compiled executables in the bin folder.
# You will compile these locally on each machine (Office/Home).
tools/bin/*
!tools/bin/.gitkeep

# --- .NET / C# ---
[Bb]in/
[Oo]bj/
*.user
*.suo

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# --- Node.js / TypeScript (For future MCP servers) ---
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# 💻 OS & IDE FILES
# ==========================================
# MacOS / Linux
.DS_Store
*.swp
*~

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains / Rider
.idea/
*.sln.iml